# API URL – used when opening the app from a different WiFi or mobile data
# Leave empty to use same device as frontend (http://HOST:3001)

# Option 1: Tunnel (ngrok / localtunnel) – use the PUBLIC URL of your API
# Example after running: npx ngrok http 3001
# VITE_API_URL=https://abc123.ngrok-free.app

# Option 2: Deployed server – use your deployed API URL
# VITE_API_URL=https://your-api.onrender.com

VITE_API_URL=
